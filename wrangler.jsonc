{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "abtl-eop",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-08-25",
	"compatibility_flags": ["nodejs_compat"],

	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},

	"observability": {
		"enabled": true
	}
}
